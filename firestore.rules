rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin allowlist for the Kisela admin dashboard. Only managed via the
    // Admin SDK (Cloud Functions / console) - never writable by clients.
    match /admins/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Scheduled/broadcast notifications created from the admin dashboard.
    // Writes only ever happen through Cloud Functions (Admin SDK), so this
    // only needs to expose read access to admins for the history view.
    match /scheduledNotifications/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Public-ish profiles: anyone signed in can browse the discover feed,
    // but you can only edit your own profile. Admins can edit/delete any
    // profile from the dashboard.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Your own swipe history. Readable by you (owner) and by the person
    // you swiped on (so they can check for a mutual like -> match).
    match /swipes/{ownerId}/targets/{targetId} {
      allow read: if signedIn() &&
        (request.auth.uid == ownerId || request.auth.uid == targetId);
      allow write: if signedIn() && request.auth.uid == ownerId;
    }

    // Matches and their chat messages are only visible to the two matched users.
    match /matches/{matchId} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn() && request.auth.uid in request.resource.data.users;

      match /messages/{messageId} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users;
        allow create: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users &&
          request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
